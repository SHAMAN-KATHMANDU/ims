# Dependencies (reinstalled in image)
**/node_modules
**/node_modules/**
.pnp
.pnp.js

# Build outputs and caches (huge; cause "no space left" in context)
**/.next
**/.next/**
**/.turbo
**/.turbo/**
**/dist
**/build
**/out

# Environment files (never ship into image)
.env
.env.*
.env.local
.env.*.local
!.env.example
!*.env.example
# Exception: web build needs apps/web/.env for NEXT_PUBLIC_* at build time
!apps/web/.env

# Git and version control
.git
.gitignore
.gitattributes

# Logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and misc
.DS_Store
*.pem
Thumbs.db

# IDE and editor
.vscode
.idea
.cursor

# Documentation (not needed for API build)
**/*.md
!apps/api/**/*.md

# Test and tooling (not needed for production image)
**/coverage
**/test-results
**/playwright-report
**/playwright/.cache
**/.nyc_output
**/__snapshots__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Vercel
.vercel

# Infra (terraform, large; not needed for app image)
infra/.terraform
infra/.terraform.lock.hcl
infra/*.tfstate
infra/*.tfstate.backup
infra/*.tfvars
!infra/*.tfvars.example

